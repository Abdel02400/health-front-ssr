{
  "name": "health-front-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env.development server/index.ts",
    "build": "tsx scripts/build.ts",
    "start": "cross-env NODE_ENV=production node dist/server-app/index.js",
    "clean": "tsx scripts/clean.ts",
    "preview": "tsx scripts/preview.ts",
    "lint": "tsc --noEmit && eslint -c eslint.config.js --ext .ts,.tsx \"src/**/*\" \"server/**/*\" \"scripts/**/*\"",
    "lf": "eslint -c eslint.config.js --ext .ts,.tsx \"src/**/*\" \"server/**/*\" \"scripts/**/*\"",
    "lint:fix": "tsc --noEmit && eslint -c eslint.config.js --ext .ts,.tsx \"src/**/*\" \"server/**/*\" \"scripts/**/*\" --fix",
    "lff": "eslint -c eslint.config.js --ext .ts,.tsx \"src/**/*\" \"server/**/*\" \"scripts/**/*\" --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:server": "vitest --project server",
    "test:server:watch": "vitest --project server --watch",
    "test:client": "vitest --project client",
    "test:client:watch": "vitest --project client --watch"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.12.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "sass": "^1.97.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.16"
  }
}