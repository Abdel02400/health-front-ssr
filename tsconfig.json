{
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": true,
    "module": "esnext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@esbuild-config": ["esbuild.config.ts"],

      "@server-config/*": ["server/config/*"],
      "@server-types/*": ["server/types/*"],
      "@server-middlewares/*": ["server/middlewares/*"],
      "@server-utils/*": ["server/utils/*"],
      "@server-runtime/*": ["server/runtime/*"],
      "@server-ssr/*": ["server/ssr/*"],
      "@server-render/*": ["server/render/*"],
      "@server-http/*": ["server/http/*"],

      "@shared-router/*": ["shared/router/*"],
      "@shared-types/*": ["shared/types/*"],
      "@shared-ssr/*": ["shared/ssr/*"],
      "@shared-constants/*": ["shared/constants/*"],

      "@client-app": ["src/App.tsx"],
      "@client-router/*": ["src/router/*"],
      "@client-assets/*": ["src/assets/*"],
      "@client-components/*": ["src/components/*"],
      "@client-store/*": ["src/store/*"],
      "@client-utils/*": ["src/utils/*"],
      "@client-auth/*": ["src/services/auth/*"],
      "@client-form/*": ["src/services/form/*"],
      "@client-hooks/*": ["src/services/hooks/*"],
      "@client-pages/*": ["src/views/pages/*"],
      "@client-forms/*": ["src/views/forms/*"],
      "@client-dtos/*": ["src/dtos/*"],
      "@client-constants/*": ["src/constants/*"],
      "@client-types/*": ["src/types/*"],
    }
  },
  "include": [
    "scripts",
    "server",
    "shared",
    "src"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
